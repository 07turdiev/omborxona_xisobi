# Ishlab chiqarish sozlamalari namunasi.
#
# Nusxa oling, to'ldiring va compose uchun `.env` ga bog'lang:
#   cp .env.production.example .env.production
#   ln -s .env.production .env
#   chmod 600 .env.production
#
# Bu fayl git'ga tushmaydi (.gitignore da `.env.*`).
#
# Qiymatlarni qo'shtirnoqsiz yozing va maxfiy qiymatlarda `$ ( ) & ' "`
# belgilarini ishlatmang: compose `$` ni o'zgaruvchi deb o'qiydi, parol
# esa DATABASE_URL ichida turadi.


# =====================================================================
# Django
# =====================================================================

# MAJBURIY. Yangi kalit yaratish:
#   openssl rand -hex 50
SECRET_KEY=

# Ishlab chiqarishda har doim False. True bo'lsa xatolar bilan birga
# sozlamalar ham ko'rinadi va /api/docs/ ochiq bo'lib qoladi.
DEBUG=False

# Qaysi domenlardan so'rov qabul qilinadi. Vergul bilan ajratiladi.
ALLOWED_HOSTS=dokon.example.uz

# Formalarni qaysi manzildan yuborish mumkin (Django 4+ talab qiladi)
CSRF_TRUSTED_ORIGINS=https://dokon.example.uz


# =====================================================================
# Baza — serverning o'zida, PostgreSQL 15+
# =====================================================================
#
# 15-versiya majburiy: variantlar jadvalidagi unikal cheklov
# `NULLS NOT DISTINCT` dan foydalanadi (15 dan boshlab bor).
#
# PAROL — o'zingiz yaratgan qiymat: openssl rand -hex 24

# MAJBURIY. Konteyner ichidan serverga `host.docker.internal` orqali boradi.
DATABASE_URL=postgres://dokon_app:PAROL@host.docker.internal:5432/dokon

# Zaxira skriptlari (scripts/backup.sh) shu uchtasini ishlatadi
POSTGRES_DB=dokon
POSTGRES_USER=dokon_app
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1


# =====================================================================
# HTTPS
# =====================================================================

# Sertifikat tashqi reverse proxy da (Caddy) — Django X-Forwarded-Proto
# ni ko'radi va HTTP so'rovni HTTPS ga yo'naltiradi
SECURE_SSL_REDIRECT=True

# HSTS: brauzer domenga faqat HTTPS orqali murojaat qiladi.
#
# DIQQAT: qaytarib olish qiyin — brauzer qiymatni eslab qoladi va
# muddat tugagunicha HTTP ga tushmaydi. Boshida 3600 (1 soat) bilan
# sinang; sertifikat bir necha hafta barqaror ishlagach 31536000
# (1 yil) ga oshiring.
SECURE_HSTS_SECONDS=3600

# Quyidagi ikkitasini faqat BARCHA subdomenlar HTTPS da ishlasa yoqing.
# `check --deploy` ular False bo'lgani uchun ogohlantiradi — bu ataylab.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False


# =====================================================================
# Boshqa
# =====================================================================

# Frontend porti. Standart holatda faqat 127.0.0.1 da ochiq — reverse
# proxy shu serverda. Proxy boshqa mashinada bo'lsa: WEB_BIND=0.0.0.0
WEB_PORT=8080
# WEB_BIND=127.0.0.1

# Gunicorn ishchilari: (2 × CPU yadrolari) + 1
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Loglash darajasi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# CORS: frontend va backend bitta domenda (nginx orqali) bo'lgani uchun
# ro'yxat bo'sh qoladi
CORS_ALLOWED_ORIGINS=

# JWT muddatlari
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
