# Ishlab chiqarish sozlamalari namunasi.
#
# Nusxa oling, to'ldiring va compose uchun `.env` ga bog'lang:
#   cp .env.production.example .env.production
#   ln -s .env.production .env
#
# Bu fayl git'ga tushmaydi (.gitignore da `.env.*`).
#
# Qiymatlarni qo'shtirnoqsiz yozing va maxfiy qiymatlarda `$ ( ) & ' "`
# belgilarini ishlatmang: compose `$` ni o'zgaruvchi deb o'qiydi, parol
# esa DATABASE_URL ichida turadi. Quyidagi buyruqlar xavfsiz qiymat beradi.


# =====================================================================
# Django
# =====================================================================

# MAJBURIY. Yangi kalit yaratish:
#   openssl rand -hex 50
SECRET_KEY=

# Ishlab chiqarishda har doim False. True bo'lsa xatolar bilan birga
# sozlamalar va SQL so'rovlari ham ko'rinadi.
DEBUG=False

# Qaysi domenlardan so'rov qabul qilinadi. Vergul bilan ajratiladi.
ALLOWED_HOSTS=ombor.example.uz,www.ombor.example.uz

# Formalarni qaysi manzildan yuborish mumkin (Django 4+ talab qiladi)
CSRF_TRUSTED_ORIGINS=https://ombor.example.uz


# =====================================================================
# Baza
# =====================================================================
#
# DIQQAT: bu rol SUPERUSER va BYPASSRLS bo'lmasligi kerak. Aks holda
# PostgreSQL Row Level Security unga qo'llanmaydi va tashkilotlar
# izolyatsiyasi butunlay ishlamaydi.
#
# `manage.py check --database default` buni tekshiradi.

POSTGRES_DB=omborxona_xisobi
POSTGRES_USER=omborxona_app
# Parol yaratish: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- A) Baza konteynerda (standart) ---------------------------------
# Hech narsa qo'shish shart emas: DATABASE_URL compose ichida quriladi.

# --- B) Baza serverning o'zida (native PostgreSQL) -------------------
# Uchala qatorni oching. PAROL — yuqoridagi POSTGRES_PASSWORD.
# COMPOSE_FILE=docker-compose.yml:docker-compose.hostdb.yml
# POSTGRES_HOST=127.0.0.1
# DATABASE_URL=postgres://omborxona_app:PAROL@host.docker.internal:5432/omborxona_xisobi


# =====================================================================
# Redis
# =====================================================================
#
# O'lchov birligi registri keshi shu yerda saqlanadi. Bir nechta
# gunicorn ishchisi bo'lganda **majburiy**: aks holda bir ishchi
# birlikni o'zgartirsa, boshqalari eskisini ishlatishda davom etadi.

# REDIS_URL docker-compose ichida avtomatik beriladi


# =====================================================================
# HTTPS
# =====================================================================

# Sertifikat tashqi reverse proxy da bo'lsa (Caddy, Traefik), Django
# qayta yo'naltirishi shart emas — u X-Forwarded-Proto ni ko'radi
SECURE_SSL_REDIRECT=True

# HSTS: brauzer domenga faqat HTTPS orqali murojaat qiladi.
#
# DIQQAT: qaytarib olish qiyin — brauzer qiymatni eslab qoladi va
# muddat tugagunicha HTTP ga tushmaydi. Boshida 3600 (1 soat) bilan
# sinang; sertifikat bir necha hafta barqaror ishlagach 31536000
# (1 yil) ga oshiring.
SECURE_HSTS_SECONDS=3600

# Quyidagi ikkitasini faqat BARCHA subdomenlar HTTPS da ishlashiga
# ishonch hosil qilgandan keyin yoqing
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False


# =====================================================================
# Boshqa
# =====================================================================

# Frontend porti. Standart holatda faqat 127.0.0.1 da ochiq — reverse
# proxy shu serverda. Proxy boshqa mashinada bo'lsa: WEB_BIND=0.0.0.0
WEB_PORT=8080
# WEB_BIND=127.0.0.1

# Gunicorn ishchilari: (2 × CPU yadrolari) + 1
GUNICORN_WORKERS=3
# Katta Excel importi uchun yetarli bo'lsin
GUNICORN_TIMEOUT=120

# Loglash darajasi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# SQL so'rovlarini ko'rish uchun DEBUG qiling — juda shovqinli
SQL_LOG_LEVEL=WARNING

# CORS: frontend va backend bitta domenda bo'lsa (nginx proxy orqali)
# bu ro'yxat bo'sh qolishi mumkin
CORS_ALLOWED_ORIGINS=

# JWT muddatlari
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
