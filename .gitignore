# =====================================================================
# Faqat o'qish uchun ma'lumotnomalar — repoga kirmaydi
# =====================================================================

# InvenTree manba kodi — faqat o'qish uchun ma'lumotnoma bo'lgan.
# Undan olingan kod loyihada qolmagan, manbaning o'zi esa repoga
# kirmaydi (2770 fayl).
InvenTree-master/
reference/

# StoreFlow dizayn prototipi. Undan olingan uslublar
# front/src/assets/app.css va login.css ga ko'chirilgan, ya'ni ilova
# bu papkasiz ham to'liq ishlaydi. Prototipning o'zi 26 000 qatorlik
# statik HTML/JS — repoda ikkinchi index.html bo'lib chalkashtiradi.
store/

# Yangi prototip manbasi (PHP) — baza paroli va foydalanuvchilar dump bor, repoga kirmaydi
new/
