# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — PAROL o'rniga o'z parolingizni qo'ying
DATABASE_URL=postgres://dokon_app:PAROL@localhost:5432/dokon

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS (Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Telegram bildirishnomalari (ixtiyoriy)
#
# Tokenni @BotFather beradi. Chat ID ni bilish uchun botga bitta xabar
# yozib, @userinfobot dan yoki
# https://api.telegram.org/bot<TOKEN>/getUpdates dan olasiz.
#
# Bir necha kishiga yuborish uchun ID lar vergul bilan yoziladi.
# Bo'sh qoldirilsa bildirishnoma yuborilmaydi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
